# PostgreSQL Connection
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/autometric

PGHOST=localhost
PGPORT=5432
PGDATABASE=autometric
PGUSER=postgres
PGPASSWORD=your_password

# Gmail SMTP (generate App Password at myaccount.google.com/apppasswords)
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password

# NextAuth
AUTH_SECRET=generate_with_openssl_rand_base64_32

# Google OAuth (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# MetaGraph Api
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Instagram OAuth (Instagram App - Sekata Connector-IG)
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
NEXT_PUBLIC_APP_URL=your_public_app_url_for_oauth_redirects (e.g., https://yourapp.ngrok-free.dev)

# TikTok OAuth (from TikTok Developer Portal > App > Keys & credentials)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# TikTok API for Business — produk TERPISAH dari Login Kit di atas. App-nya
# didaftarkan di business-api.tiktok.com/portal/apps, bukan developers.tiktok.com,
# jadi kredensialnya tidak saling menggantikan. Kosongkan kalau tidak dipakai:
# opsi "TikTok Business API" di layar connect akan menolak dengan pesan jelas
# alih-alih mengarahkan orang ke halaman izin yang pasti gagal.
# Redirect URI yang harus didaftarkan di portal:
#   <NEXT_PUBLIC_APP_URL tanpa garis miring di ujung>/api/auth/tiktok-business/callback
TIKTOK_BUSINESS_APP_ID=your_tiktok_business_app_id
TIKTOK_BUSINESS_SECRET=your_tiktok_business_secret
# Jendela tarik AWAL untuk video TikTok Business, dalam hari. Default 30.
# Hanya dipakai saat akun baru disambungkan dan saat initial-sync dipanggil
# manual; sync malam selalu 30 hari. Menyentuh video saja — metrik profil selalu
# 30 hari karena tabelnya tidak bisa menyimpan riwayat harian.
# Contoh: 686 = mundur sampai 1 November 2024.
# TIKTOK_BUSINESS_BACKFILL_DAYS=30

# Cloudinary (for avatar storage — create a free account at cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Instagram snapshot window (days of historical data to fetch, default 60)
IG_SNAPSHOT_DAYS=60

# Matikan cron di instance ini (daily-sync + competitor). Kosong/tidak diisi = cron
# JALAN. Wajib diisi di instance yang berbagi DATABASE_URL dengan instance lain —
# mis. staging yang menunjuk DB production: dua cron pada DB yang sama akan
# menjalankan scheduler dobel, dan refresh token TikTok yang dirotasi membuat proses
# kedua kena invalid_grant lalu akunnya ditandai terputus.
# DISABLE_CRON=true

# Scheduler secret — used to authenticate POST /api/scheduler/run
# Generate with: openssl rand -base64 32
SCHEDULER_SECRET=your_scheduler_secret

# Apify API (competitor scraping — Instagram, Facebook & TikTok; get token at apify.com)
APIFY_API_TOKEN=your_apify_api_token